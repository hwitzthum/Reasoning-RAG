# Reasoning-RAG Environment Configuration

# Required: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/reasoning_rag.db

# Document Storage
DOCUMENTS_PATH=./documents

# Reasoning Parameters
MAX_REASONING_ITERATIONS=8
QUERY_TIMEOUT_SECONDS=60
INGESTION_TIMEOUT_SECONDS=300

# Cache Runtime Controls
DRY_RUN_CACHE_ONLY=false
QUERY_CACHE_TTL_SECONDS=86400

# LLM Models
REASONING_MODEL=claude-sonnet-4-6
ANNOTATION_MODEL=claude-haiku-4-5-20251001

# Logging
LOG_LEVEL=INFO
